# coverage.py (used by pytest-cov)
[run]
source = shadowsim
branch = True

[report]
show_missing = True
precision = 2
# Fail the coverage run if total coverage drops below this floor. Adjust upward toward
# the codecov target (70..90) as coverage allows (currently ~78%).
fail_under = 75
omit =
    */__init__.py
    */test/*
    */tests/*
    */virtualenvs/*
    */.tox/*
    */venv/*
    */.venv/*

[html]
directory = coverage_html_report
