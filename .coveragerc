# coverage.py (used by pytest-cov)
[run]
source = shadowsim
branch = True

[report]
show_missing = True
precision = 2
# Fail the coverage run if total coverage drops below this floor.
fail_under = 90
omit =
    */__init__.py
    */test/*
    */tests/*
    */virtualenvs/*
    */.tox/*
    */venv/*
    */.venv/*
    # Excluded from the default pytest run; see pytest addopts.
    */cli/serve.py

[html]
directory = coverage_html_report
